# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)

# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹)에서 확인
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급 — 서버에서만 사용됩니다
GEMINI_API_KEY=

# 선택 사항
# GEMINI_MODEL=gemini-flash-latest
